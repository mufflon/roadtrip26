<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="color-scheme" content="dark">
  <meta name="theme-color" content="#0e2b2b">
  <title>{{ title }}</title>
  <meta name="description" content="{{ description }}">

  <link rel="stylesheet" href="{{ '/assets/style.css' | url }}">

  <!-- Installable offline app: manifest + iOS "Add to Home Screen" support. -->
  <link rel="manifest" href="{{ '/manifest.webmanifest' | url }}">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="Roadtrip 26">
  <link rel="apple-touch-icon" href="{{ '/assets/icon-180.png' | url }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/assets/icon-192.png' | url }}">

  <!-- Leaflet 1.9.4, bundled locally so the map works offline and needs no CDN.
       Deferred so it never blocks the list; the page is usable if it fails. -->
  <link rel="stylesheet" href="{{ '/assets/leaflet/leaflet.css' | url }}">
  <script defer src="{{ '/assets/leaflet/leaflet.js' | url }}"></script>
  <script type="module" src="{{ pageScript | url }}"></script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>

  <header class="topbar">
    <div class="topbar__brand">
      <span class="topbar__title">Budapest → Rostock</span>
      <span class="topbar__sub">August 2026 · pick as you go</span>
    </div>
    <nav class="topbar__nav" aria-label="Primary">
      <a href="{{ '/' | url }}"
         {% if page.url == ('/' | url) %}aria-current="page"{% endif %}>Sites</a>
      <a href="{{ '/trails.html' | url }}"
         {% if page.url == ('/trails.html' | url) %}aria-current="page"{% endif %}>Trails</a>
    </nav>
  </header>

  <main id="main" class="layout">
    {{ content | safe }}
  </main>

  <footer class="sitefoot">
    <p>
      Map data © <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>
      contributors. Tiles from OpenStreetMap. Not a plan — a list of candidates.
    </p>
    <p class="sitefoot__note">
      Opening hours are a snapshot, not a guarantee. Always check before you go.
    </p>
  </footer>

  <!-- Register the service worker so the site installs and works offline.
       Failure is silent: online, everything works without it. -->
  <script>
    if ("serviceWorker" in navigator) {
      window.addEventListener("load", function () {
        navigator.serviceWorker
          .register("{{ '/sw.js' | url }}", { scope: "{{ '/' | url }}" })
          .catch(function () {});
      });
    }
  </script>
</body>
</html>
